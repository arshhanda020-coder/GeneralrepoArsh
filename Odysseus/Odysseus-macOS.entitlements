<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.microphone</key>
	<true/>
	<!-- iCloud/CloudKit and Time-Sensitive Notifications entitlements are commented
	     out below rather than deleted: a Personal Team (free Apple ID) cannot be
	     provisioned with either capability, which blocks every local build. CloudKit
	     sync (OdysseusApp.swift, cloudKitDatabase: .private(...)) and time-sensitive
	     due-date notifications are real, working features on a paid Apple Developer
	     Program team — uncomment this block and re-add the same block to
	     Odysseus.entitlements once this project is signed with a paid team.
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.traderforge.Odysseus</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)com.traderforge.Odysseus</string>
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Production</string>
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	-->
</dict>
</plist>
